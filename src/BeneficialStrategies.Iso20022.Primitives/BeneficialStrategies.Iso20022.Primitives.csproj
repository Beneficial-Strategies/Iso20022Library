<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM policy: see BeneficialStrategies.Iso20022.Common.csproj. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BeneficialStrategies.Iso20022.Primitives</PackageId>
    <PackageDescription>The ISO 20022 primitive data types, code sets and external codes, with their format validation and JSON converters, without the message records.</PackageDescription>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>


  <!-- netstandard2.0 (.NET Framework 4.6.1+, Mono, Unity): what the newer runtimes have in the box -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" Version="8.*" />
    <PackageReference Include="Portable.System.DateTimeOnly" Version="8.*" />
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
    <PackageReference Include="Microsoft.Bcl.HashCode" Version="1.*" />
  </ItemGroup>

</Project>
