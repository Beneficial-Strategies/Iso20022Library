<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!--
    CS0618/CS0612: obsolete-member-usage warnings. Suppressed in normal builds because the
    ISO 20022 spec retires types slowly — active types legitimately reference obsolete parents
    for years (e.g. derived codesets that inherit enum ordinals from an obsolete base codeset).
    Run annually during snapshot-sync-verify with -p:EnableObsoleteWarnings=true to audit the
    tangle and decide what can be removed.
  -->
  <PropertyGroup Condition="'$(EnableObsoleteWarnings)' != 'true'">
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BeneficialStrategies.Iso20022</PackageId>
    <PackageDescription>The entirety of the ISO20022 message domain model. 3,311 B2B financial messages structured as immutable records based on the ISO20022 standard.</PackageDescription>
    <Version>0.6.1-alpha</Version>
    <Authors>Jeff Ward,Beneficial Strategies</Authors>
    <Company>BeneficialStrategies.com</Company>
    <RepositoryUrl>https://github.com/Beneficial-Strategies/Iso20022Library</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
      <None Include="..\..\doc\package\README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>