<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      TFM policy: multi-target the two most recent LTS releases (not the two most recent version
      numbers — see CLAUDE.md "Target Framework Policy" for why that distinction matters). net9.0
      is STS and reaches end-of-support the same day as net8.0 (2026-11-10), so it's deliberately
      not included.
    -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <!-- CS0618/CS0612 suppression now lives repo-wide in src/Directory.Build.props. -->

  <PropertyGroup>
    <PackageId>BeneficialStrategies.Iso20022</PackageId>
    <PackageDescription>The entirety of the ISO20022 message domain model. 3,311 B2B financial messages structured as immutable records based on the ISO20022 standard.</PackageDescription>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
      <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

</Project>