<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- netstandard2.0 (.NET Framework 4.6.1+, Mono, Unity) like Primitives, which it references; see CLAUDE.md, Target Framework Policy. -->
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022.Factory</RootNamespace>
    <AssemblyName>BeneficialStrategies.Iso20022.Factory</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BeneficialStrategies.Iso20022.Factory</PackageId>
    <PackageDescription>Read ISO 20022 messages into their interfaces without the message records: the classes that implement the interfaces are built at run time, once per type. Needs only the Primitives package.</PackageDescription>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="8.*" />
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Primitives\BeneficialStrategies.Iso20022.Primitives.csproj" />
  </ItemGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="Polyfill" Version="11.*" PrivateAssets="all" />
    <!-- netstandard2.0 itself has no Reflection.Emit; this package brings the API (the implementation is in .NET Framework, .NET and Mono). -->
    <PackageReference Include="System.Reflection.Emit" Version="4.7.0" />
  </ItemGroup>

</Project>
