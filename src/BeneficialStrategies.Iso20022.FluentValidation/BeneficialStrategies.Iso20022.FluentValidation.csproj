<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- TFM policy: same rationale and same two targets as BeneficialStrategies.Iso20022.Common — see that project's csproj. -->
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BeneficialStrategies.Iso20022.Validation</RootNamespace>
    <AssemblyName>BeneficialStrategies.Iso20022.FluentValidation</AssemblyName>
    <!--
      Enabled deliberately, even though none of the ~1,004 validator constructors carry XML doc
      comments today: the validator CLASSES themselves already carry rich <summary>/<remarks>
      content (which spec constraints each one enforces — see CLAUDE.md's "Adding a New
      Validator" section) that was previously compiled into nothing, since no .xml doc file was
      ever generated. Consumers got zero IntelliSense benefit from that content despite it already
      existing in source. CS1591 (missing doc comment) is suppressed below rather than blocking on
      it, matching BeneficialStrategies.Iso20022.Common's own CS0618/CS0612 precedent — the
      per-constructor doc gap is a real, tracked follow-up (matches CLAUDE.md's non-negotiable doc
      standard for the main library), not something to silently drop or to let block shipping the
      documentation that already exists.
    -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsPackable>true</IsPackable>
  </PropertyGroup>

  <!--
    CS1591: missing XML doc comment on a publicly visible member. Suppressed in normal builds
    because none of the ~1,004 validator constructors carry their own doc comment yet (their
    containing classes do). Run with -p:EnableMissingDocWarnings=true to see the real count and
    work through it — same convention as Common's -p:EnableObsoleteWarnings.
  -->
  <PropertyGroup Condition="'$(EnableMissingDocWarnings)' != 'true'">
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <!--
    CS1574: XML comment <see cref="..."/>/<seealso cref="..."/> references a type/member name
    that doesn't resolve — 173 instances found the moment doc-file generation first turned this
    check on (2026-08-31), mostly unqualified Choice-variant names (e.g. cref="Code" instead of
    the fully-qualified sub-namespace form) and cross-references between component/message
    validators. Suppressed for now as a separate, independently-auditable debt category from
    CS1591 above — run with -p:EnableBrokenCrefWarnings=true to see the current count.
  -->
  <PropertyGroup Condition="'$(EnableBrokenCrefWarnings)' != 'true'">
    <NoWarn>$(NoWarn);CS1574</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <PackageId>BeneficialStrategies.Iso20022.FluentValidation</PackageId>
    <PackageDescription>FluentValidation validators for the BeneficialStrategies.Iso20022 message domain model. Full ISO 20022 spec-compliance coverage for CAMT-reachable components; abbreviated (minimum-collection-size) coverage for the remaining components pending full review.</PackageDescription>
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText("$(MSBuildProjectDirectory)/release-notes.txt"))</PackageReleaseNotes>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="11.*" />
    <!--
      Powers AddIso20022Validators() (Extensions/ServiceCollectionExtensions.cs) — a thin wrapper
      around FluentValidation's own AddValidatorsFromAssemblyContaining<T>(). Pulls in
      Microsoft.Extensions.DependencyInjection.Abstractions transitively, which is standard and
      expected for a validators package designed for DI registration.
    -->
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="11.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BeneficialStrategies.Iso20022.Common\BeneficialStrategies.Iso20022.Common.csproj" />
  </ItemGroup>

</Project>
