<Project>

  <!--
    Shared package metadata for every packable project under src/. Centralizing these here makes
    version desync between BeneficialStrategies.Iso20022 and its companion packages
    (BeneficialStrategies.Iso20022.FluentValidation, and future ones such as .Sagas)
    structurally impossible rather than merely policy-enforced — see CLAUDE.md
    "Multi-Package Repository Strategy" for why these packages are released in lockstep.

    Package-specific properties (PackageId, PackageDescription, PackageReleaseNotes, and the
    packed README wiring) stay in each project's own .csproj, since that text necessarily differs
    per package.
  -->
  <PropertyGroup>
    <Version>0.6.2-alpha</Version>
    <Authors>Jeff Ward,Beneficial Strategies</Authors>
    <Company>BeneficialStrategies.com</Company>
    <RepositoryUrl>https://github.com/Beneficial-Strategies/Iso20022Library</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <DebugType>embedded</DebugType>
  </PropertyGroup>

  <!--
    Zero-warnings is a minimum standard for this repo (2026-08-31): any warning not explicitly
    suppressed below fails the build, both locally and in .github/workflows/ci.yml. This exists
    because CS1591/CS1574 sat unnoticed at ~1,000/171 instances respectively in
    BeneficialStrategies.Iso20022.FluentValidation until someone happened to look — a warning
    nobody's build fails on is a warning nobody actually sees.
  -->
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <!--
    CS0618/CS0612: obsolete-member-usage warnings, suppressed repo-wide (every project under
    src/, not just BeneficialStrategies.Iso20022.Common — FluentValidation and its Tests project
    reference obsolete-marked types too, e.g. in tests that specifically verify an [Obsolete]
    marker was applied correctly). The ISO 20022 spec retires types slowly — active types
    legitimately reference obsolete parents for years (e.g. derived codesets that inherit enum
    ordinals from an obsolete base codeset) — so this is an ongoing, expected condition, not a
    bug to fail the build over. Run annually during snapshot-sync-verify with
    -p:EnableObsoleteWarnings=true to audit the tangle and decide what can be removed.
  -->
  <PropertyGroup Condition="'$(EnableObsoleteWarnings)' != 'true'">
    <NoWarn>$(NoWarn);CS0618;CS0612</NoWarn>
  </PropertyGroup>

</Project>
